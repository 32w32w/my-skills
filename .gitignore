# 操作系统生成的文件
.DS_Store
Thumbs.db
Desktop.ini

# 临时文件、编辑器备份和日志
*.tmp
*.temp
*.swp
*.swo
*~
*.log

# 本地环境配置；保留不含密钥的示例文件
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# Python 缓存和虚拟环境
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node.js 依赖和包管理器缓存
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
